rules_version = '2';

// Candidate rules for the paths present in this repository. Review before deployment.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    // Trusted diary ingestion uses Admin SDK/IAM. Browsers cannot edit school data.
    match /schoolGrades/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
    }
    // schoolHomework/{uid}: Admin-owned schemaVersion/source/range/syncedAt/items.
    // items is a map keyed by SHA-256 task ID; progress is an optional map of
    // task ID -> bool. Browsers may change only progress on current tasks.
    match /schoolHomework/{uid} {
      function validHomeworkProgress() {
        let d = request.resource.data;
        let previous = resource.data.get('progress', {});
        return d.keys().hasAll(['schemaVersion', 'source', 'rangeFrom', 'rangeTo', 'syncedAt', 'items', 'progress'])
          && d.keys().hasOnly(['schemaVersion', 'source', 'rangeFrom', 'rangeTo', 'syncedAt', 'items', 'progress'])
          && d.schemaVersion == 1 && d.items is map
          && d.progress is map && d.progress.size() <= 2000
          && d.progress.values().hasOnly([true, false])
          && d.diff(resource.data).affectedKeys().hasOnly(['progress'])
          && d.progress.diff(previous).removedKeys().size() == 0
          && d.progress.diff(previous).affectedKeys().hasOnly(resource.data.items.keys());
      }
      allow get: if owner(uid);
      allow list, create, delete: if false;
      allow update: if owner(uid) && validHomeworkProgress();
    }
    match /profiles/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
    }

    match /users/{uid}/wordscene/{documentId} {
      function validPayload(p) {
        // Keep legacy fields in the payload; do not silently discard saved progress.
        return p is map && p.keys().hasAll(['version', 'words'])
          && p.keys().size() <= 32 && p.version == 5
          && p.words is map && p.words.size() <= 500
          && (!('session' in p) || p.session == null || p.session is map)
          && (!('reviewCycle' in p) || (p.reviewCycle is list && p.reviewCycle.size() <= 500))
          && (!('habit' in p) || (p.habit is map && p.habit.days is map))
          && (!('reviewVersion' in p) || p.reviewVersion == 1)
          && (!('soundEnabled' in p) || p.soundEnabled is bool);
      }
      function validState() {
        let d = request.resource.data;
        return d.keys().hasAll(['schemaVersion', 'revision', 'updatedAt', 'clientSavedAt', 'payload'])
          && d.keys().hasOnly(['schemaVersion', 'revision', 'updatedAt', 'clientSavedAt', 'payload'])
          && d.schemaVersion == 1
          && d.revision is int && d.revision > 0
          && d.updatedAt == request.time
          && d.clientSavedAt is int && d.clientSavedAt >= 0
          && validPayload(d.payload);
      }
      function ownState() { return owner(uid) && documentId == 'state'; }
      allow get: if ownState();
      allow list, delete: if false;
      allow create: if ownState() && validState() && request.resource.data.revision == 1;
      allow update: if ownState() && validState()
                    && request.resource.data.revision == resource.data.revision + 1;
    }

    match /{path=**} { allow read, write: if false; }
  }
}
