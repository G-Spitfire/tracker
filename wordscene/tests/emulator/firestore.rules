rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /schoolGrades/{userId} {
      allow get: if request.auth != null
                 && request.auth.uid == userId;

      allow list, create, update, delete: if false;
    }

    match /profiles/{userId} {
      allow get: if request.auth != null
                 && request.auth.uid == userId;

      allow list, create, update, delete: if false;
    }

    match /users/{userId}/wordscene/{documentId} {

      function isOwner() {
        return request.auth != null
               && request.auth.uid == userId
               && documentId == 'state';
      }

      function validState() {
        let d = request.resource.data;

        return d.keys().hasAll([
                 'schemaVersion',
                 'revision',
                 'updatedAt',
                 'clientSavedAt',
                 'payload'
               ])
               && d.keys().hasOnly([
                 'schemaVersion',
                 'revision',
                 'updatedAt',
                 'clientSavedAt',
                 'payload'
               ])
               && d.schemaVersion == 1
               && d.revision is int
               && d.updatedAt == request.time
               && d.clientSavedAt is int
               && d.payload is map
               && d.payload.words is map;
      }

      allow get: if isOwner();
      allow list, delete: if false;

      allow create: if isOwner()
                    && validState()
                    && request.resource.data.revision == 1;

      allow update: if isOwner()
                    && validState()
                    && request.resource.data.revision
                       == resource.data.revision + 1;
    }
  }
}
